      "bullets": [
        { "text": "我独立完成了XX功能的设计与开发，将XX效率提升了XX%", "match_reason": "对应JD中'XX能力'的要求", "match_score": "high" },
        { "text": "我主动梳理了XX流程，解决了XX问题", "match_reason": "...", "match_score": "high" },
        { "text": "我与XX协作完成了XX任务", "match_reason": "...", "match_score": "medium" },
