def _call_deepseek(prompt: str, has_jd: bool = False) -> dict:
    """调用 DeepSeek API，返回原始响应"""
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {DEEPSEEK_API_KEY}"
    }

    if has_jd:
        system_msg = (
            "你是一个专业的简历内容顾问，同时具备招聘方视角。"
            "核心原则：职业概述和核心优势要精炼有力，每个字都有信息量，优先展示与JD最匹配的能力。"
            "你必须严格按照用户要求的JSON格式返回结果，不要包含任何额外文字。"
            "核心原则：每个bullet都必须让面试官觉得'这个人的经历跟我们的岗位很匹配'。"
        )
    else:
        system_msg = (
            "你是一个专业的简历内容顾问。"
            "你必须严格按照用户要求的JSON格式返回结果，不要包含任何额外文字。"
        )

    data = {
        "model": DEEPSEEK_MODEL,
        "messages": [
            {"role": "system", "content": system_msg},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.5 if has_jd else 0.3,
        # v0.2 输出更多板块，token 额度提高
        "max_tokens": 10000 if has_jd else 7000
    }

    response = requests.post(DEEPSEEK_API_URL, headers=headers, json=data, timeout=120)
    response.raise_for_status()
    return response.json()


def _parse_ai_response(ai_content: str) -> dict:
    """从 AI 返回的文本中提取 JSON，容错处理"""
    text = ai_content.strip()

    if "```json" in text:
        start = text.index("```json") + 7
        end = text.index("```", start)
        text = text[start:end].strip()
    elif "```" in text:
        start = text.index("```") + 3
        end = text.index("```", start)
        text = text[start:end].strip()

    return json.loads(text)


def _normalize_bullets(raw_bullets: list) -> list[BulletPoint]:
    """
    兼容处理：AI 可能返回纯字符串数组或对象数组。
    统一转为 BulletPoint 对象列表。
    """
    result = []
    for b in raw_bullets:
        if isinstance(b, str):
            result.append(BulletPoint(text=b, match_reason="", match_score="medium"))
        elif isinstance(b, dict):
            result.append(BulletPoint(
                text=b.get("text", ""),
                match_reason=b.get("match_reason", ""),
                match_score=b.get("match_score", "medium")
            ))
    return result


def _normalize_skills(raw_skills) -> list[SkillGroup]:
    """
    兼容处理：AI 可能返回分类对象数组或旧的纯字符串数组。
    统一转为 SkillGroup 对象列表。
    """
    if not raw_skills:
        return []

    # 如果第一个元素是 dict（新格式），直接解析
    if isinstance(raw_skills[0], dict):
        groups = []
        for s in raw_skills:
            groups.append(SkillGroup(
                category=s.get("category", "其他"),
                items=s.get("items", [])
            ))
        return groups

    # 如果第一个元素是 str（旧格式），全部塞到"专业技能"分组
    if isinstance(raw_skills[0], str):
        return [SkillGroup(category="专业技能", items=raw_skills)]

    return []


def _normalize_interview_tips(raw_tips: list) -> list[InterviewTip]:
    """解析面试话术"""
    result = []
    for tip in raw_tips:
        if isinstance(tip, dict):
            result.append(InterviewTip(
                experience_name=tip.get("experience_name", ""),
                questions=tip.get("questions", [])
            ))
    return result


def _normalize_jd_analysis(raw: dict) -> dict:
    """
    归一化 JD 分析结果，确保 match_score 存在、gaps 每条都是 {gap, suggestion} 对象。
    AI 模型不一定严格遵循格式，这里做兜底处理。
    """
    analysis = dict(raw) if raw else {}

    # match_score 兜底：如果 AI 没返回，给空字符串（前端判断显示）
    if "match_score" not in analysis:
        analysis["match_score"] = ""

    # gaps 归一化：字符串 → {gap, suggestion} 对象
    raw_gaps = analysis.get("gaps", [])
    normalized_gaps = []
    for item in raw_gaps:
        if isinstance(item, str):
            normalized_gaps.append({"gap": item, "suggestion": ""})
        elif isinstance(item, dict):
            normalized_gaps.append({
                "gap": item.get("gap", ""),
                "suggestion": item.get("suggestion", ""),
            })
    analysis["gaps"] = normalized_gaps

    return analysis


def generate_resume(data: ResumeRequest) -> ResumeResponse:
    """主入口：接收用户数据 → 调 AI → 返回结构化简历内容"""
    has_jd = bool(data.job_description.strip())
    prompt = _build_prompt(data)
    result = _call_deepseek(prompt, has_jd=has_jd)

    ai_content = result["choices"][0]["message"]["content"]
    usage = result.get("usage", {})
    parsed = _parse_ai_response(ai_content)

    # 按类型拆分经历
    all_exp = parsed.get("experience", [])
    work_exp = []
    project_exp = []
    for exp in all_exp:
        exp_type = exp.get("type", "")
        if not exp_type:
            exp_type = "work" if exp.get("company") else "project"
            exp["type"] = exp_type

        # 兼容处理 bullets（新格式: 对象数组 / 旧格式: 字符串数组）
        exp["bullets"] = _normalize_bullets(exp.get("bullets", []))

        if exp_type == "work":
            work_exp.append(PolishedExperience(**exp))
        else:
            project_exp.append(PolishedExperience(**exp))

    # 解析技能（新格式: SkillGroup[] / 旧格式: str[]）
    skills = _normalize_skills(parsed.get("skills", []))

    # 解析面试话术
    interview_tips = _normalize_interview_tips(parsed.get("interview_tips", []))

    return ResumeResponse(
        name=data.personal.name,
        phone=data.personal.phone,
        email=data.personal.email,
        target_position=data.target_position,
        # v0.2 新板块
        job_objective=parsed.get("job_objective", ""),
        career_summary=parsed.get("career_summary", ""),
        core_strengths=ensure_core_strengths_count(
            parsed.get("core_strengths", []), has_jd,
            data.job_description if has_jd else "", data.target_position
        ),
        self_evaluation=parsed.get("self_evaluation", ""),
        interview_tips=interview_tips,
        # 经历
        education=data.education,
        experience=work_exp,
        project_experience=project_exp,
        # 技能 & 证书
        skills=skills,
        certificates=parsed.get("certificates", []),
        # 分析 & 元数据
        jd_analysis=_normalize_jd_analysis(parsed.get("jd_analysis", {})),
        token_usage={
            "input_tokens": usage.get("prompt_tokens", 0),
            "output_tokens": usage.get("completion_tokens", 0),
            "total_tokens": usage.get("total_tokens", 0),
        },
        # 向后兼容
        summary=parsed.get("summary", parsed.get("career_summary", "")),
    )
